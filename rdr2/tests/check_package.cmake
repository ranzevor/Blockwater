if(NOT DEFINED BUILD_DIR OR NOT DEFINED DESTINATION OR NOT DEFINED CONFIG)
    message(FATAL_ERROR "Build, configuration and staging directory are required")
endif()
file(MAKE_DIRECTORY "${DESTINATION}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}"
    --config "${CONFIG}" --prefix "${DESTINATION}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Plugin staging failed")
endif()
file(GLOB_RECURSE actual RELATIVE "${DESTINATION}" "${DESTINATION}/*")
set(expected "Blockwater.asi" "licenses/Garrys-Redemption.txt" "licenses/LICENSE")
list(SORT actual)
list(SORT expected)
if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Unexpected staged files: ${actual}")
endif()
file(SIZE "${DESTINATION}/Blockwater.asi" plugin_size)
if(plugin_size LESS 1024)
    message(FATAL_ERROR "Plugin binary is absent or incomplete")
endif()
